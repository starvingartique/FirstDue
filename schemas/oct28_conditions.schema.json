{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firstdue.game/schemas/oct28_conditions.schema.json",
  "title": "oct28_conditions.json - Oct 28 core conditions for Bike down",
  "description": "Small set modeled separately from the DRAFT conditions.json: femoral bleed, trauma hypothermia, crash stress offset, road rash.",
  "type": "object",
  "required": ["_meta", "conditions"],
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["version", "status"],
      "properties": {
        "version": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "effects", "findings", "minLevel", "generatorReady"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "region": { "type": "string" },
          "effects": { "type": "object" },
          "findings": { "type": "object" },
          "minLevel": { "type": "integer", "minimum": 1, "maximum": 5 },
          "generatorReady": { "type": "boolean" }
        }
      }
    }
  }
}
