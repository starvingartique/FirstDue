{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firstdue.game/schemas/environments.schema.json",
  "title": "environments.json - locations, time, weather and hazards",
  "description": "Scene locations with time-of-day, weather and hazard options. Skeleton holds placeholders only.",
  "type": "object",
  "required": ["_meta", "environments"],
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["version", "status"],
      "properties": {
        "version": { "type": "string" },
        "status": { "type": "string" },
        "sourceNote": { "type": "string" }
      }
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "timesOfDay": { "type": "array", "items": { "type": "string" } },
          "weather": { "type": "array", "items": { "type": "string" } },
          "hazards": { "type": "array", "items": { "type": "string" } },
          "weight": {
            "anyOf": [{ "type": "number" }, { "type": "string" }]
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
