{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firstdue.game/schemas/bystanders.schema.json",
  "title": "bystanders.json - bystander archetypes",
  "description": "Archetype-driven bystanders who can help, obstruct or lie. Skeleton holds placeholders only.",
  "type": "object",
  "required": ["_meta", "archetypes"],
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["version", "status"],
      "properties": {
        "version": { "type": "string" },
        "status": { "type": "string" },
        "sourceNote": { "type": "string" }
      }
    },
    "archetypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "behavior"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "behavior": { "type": "string" },
          "helpsWith": { "type": "array", "items": { "type": "string" } },
          "obstructsWith": { "type": "array", "items": { "type": "string" } },
          "sampleLines": { "type": "array", "items": { "type": "string" } },
          "weight": {
            "anyOf": [{ "type": "number" }, { "type": "string" }]
          }
        }
      }
    }
  }
}
