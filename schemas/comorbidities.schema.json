{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firstdue.game/schemas/comorbidities.schema.json",
  "title": "comorbidities.json - histories, home meds and physiology modifiers",
  "description": "Common past histories and home meds plus how they modify the compensation curve. Skeleton holds placeholders only.",
  "type": "object",
  "required": ["_meta", "entries"],
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["version", "status"],
      "properties": {
        "version": { "type": "string" },
        "status": { "type": "string" },
        "sourceNote": { "type": "string" }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "homeMeds": { "type": "array", "items": { "type": "string" } },
          "physiologyModifiers": { "type": "object" },
          "examMasks": { "type": "array", "items": { "type": "string" } },
          "weight": {
            "anyOf": [{ "type": "number" }, { "type": "string" }]
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
