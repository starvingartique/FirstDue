{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firstdue.game/schemas/march_paws.schema.json",
  "title": "march_paws.json - trauma assessment framework and scoring",
  "description": "Ordered MARCH-PAWS steps with checks, interventions, graded errors and time targets. Matches the provided DRAFT file.",
  "type": "object",
  "required": ["_meta", "sequence", "reassessment"],
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step", "name"],
        "properties": {
          "step": { "type": "string" },
          "name": { "type": "string" },
          "checks": { "type": "array", "items": { "type": "string" } },
          "interventions": { "type": "array", "items": { "type": "string" } },
          "graded": { "type": "array", "items": { "type": "string" } },
          "timeTarget_s": { "type": ["integer", "null"] },
          "applies": { "type": "string" }
        }
      }
    },
    "reassessment": { "type": "string" },
    "difficultyBehavior": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}
